# Maintainer: Omarchy Calendar contributors
pkgname=omarchy-calendar
pkgver=0.9.0
pkgrel=1
pkgdesc='A polished native calendar for Omarchy'
arch=('x86_64' 'aarch64')
url='https://lastrefuge.ai/projects/omarchy-calendar'
license=('MIT')
depends=('glib2' 'glibc' 'libsecret' 'qt6-base' 'qt6-declarative' 'qt6-networkauth' 'xdg-utils')
makedepends=('cmake' 'git' 'ninja' 'pkgconf')
optdepends=('qt6-wayland: native Wayland support')
source=("git+https://github.com/jasona/omarchy-calendar.git#tag=v${pkgver}")
b2sums=('SKIP')

build() {
  local oauth_args=()
  local release_args=()
  if [[ -f "$startdir/../google-oauth.env" ]]; then
    oauth_args+=("-DOMARCHY_CALENDAR_OAUTH_ENV_FILE=$startdir/../google-oauth.env")
  fi
  [[ -z "${OMARCHY_CALENDAR_HOMEPAGE_URL:-}" ]] || release_args+=("-DOMARCHY_CALENDAR_HOMEPAGE_URL=$OMARCHY_CALENDAR_HOMEPAGE_URL")
  [[ -z "${OMARCHY_CALENDAR_PRIVACY_URL:-}" ]] || release_args+=("-DOMARCHY_CALENDAR_PRIVACY_URL=$OMARCHY_CALENDAR_PRIVACY_URL")
  [[ -z "${OMARCHY_CALENDAR_TERMS_URL:-}" ]] || release_args+=("-DOMARCHY_CALENDAR_TERMS_URL=$OMARCHY_CALENDAR_TERMS_URL")
  if [[ -n "${OMARCHY_CALENDAR_SUPPORT_EMAIL:-}" ]]; then
    release_args+=("-DOMARCHY_CALENDAR_SUPPORT_EMAIL=$OMARCHY_CALENDAR_SUPPORT_EMAIL")
  fi
  cmake -S "$pkgname" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -Wno-dev \
    "${oauth_args[@]}" \
    "${release_args[@]}"
  cmake --build build
}

check() {
  "$srcdir/build/omarchy-calendar-service" --version
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
